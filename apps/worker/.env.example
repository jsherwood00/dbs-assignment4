# Copy to .env.local and fill in real values.
# .env.local is gitignored; .env.example is committed as a reference.

# Supabase project URL (same value used by the web app)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Service role key — SERVER-ONLY. Bypasses RLS. Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# How often the worker polls amtraker, in ms.
# Note: amtraker's upstream GPS only updates each train every 2-5 minutes,
# so polling faster mostly just re-writes the same rows for no benefit.
# 300000 (5 min) matches the upstream cadence and keeps Supabase Realtime
# message volume + bandwidth well inside the free tier.
POLL_INTERVAL_MS=300000
