# Copy to .env.local and fill in real values.
# .env.local is gitignored; .env.example is committed as a reference.

# Supabase project URL (same value used by the web app)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Service role key — SERVER-ONLY. Bypasses RLS. Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# How often the worker polls amtraker, in ms. 30000 is a friendly default.
POLL_INTERVAL_MS=30000
